---
import {TitleDivider} from "@repo/ui/TitleDivider";
import Lines_Img from "@repo/assets/public/images/lines-bg.svg";
import Service_Flight_Img from "@repo/assets/public/images/service-flight.jpeg";
import Service_Hotel_Img from "@repo/assets/public/images/service-hotel.jpeg";
import Service_Car_Rental_Img from "@repo/assets/public/images/service-car-rental.jpeg";
import {Image} from "astro:assets";
import {Button} from "@repo/ui/button";
import { ChevronRight, ChevronLeft } from 'lucide-react';
---

<div class="services-content font-cabinRegular relative">
    <Image
        class = { 'absolute w-full inset-0' }
        src = { Lines_Img }
        alt = { 'lines_back_img' }
        loading = { 'lazy' }
        decoding = { 'async' }
    />

    <div class="container-group flex flex-col">
        <div class="container gap-5 flex-wrap max-w-full pt-[5.625rem] pl-20 pb-20 relative">
            <TitleDivider className = "w-auto" title = "Complementa tu experiencia" />
        </div>

        <div class="content flex items-center justify-between gap-8 relative pl-20 pr-20 pb-10">
            <div class="container-description flex flex-col gap-4">
                <h3 class="text-4xl font-reaktifSemibold" >
                    Sugerencias de hoteles
                </h3>
                <h5 class="text-[18px] text-[#78858F] font-cabinRegular" >
                    Alojamientos que te sorprenderán
                </h5>
                <p class="text-[19px]/5" >
                    ¿No sabéis dónde quedarse? <br>
                    Te mostraremos nuestras  <br> recomendaciones que puedes ajustar a  <br> tus preferencias, inspirate y elige.
                </p>
            </div>

            <div class="container-elements">

            </div>
            <div class="container-services flex items-end gap-8">
                <div class="service-flight relative w-[240px] h-[240px] rounded-2xl overflow-hidden bg-[#000000]/60">
                    <Image
                            class = { 'w-full h-full object-cover' }
                            src = { Service_Flight_Img }
                            alt = { 'service_flight_img' }
                            loading = { 'lazy' }
                            decoding = { 'async' }
                    />

                    <div class="absolute inset-0 bg-black bg-opacity-50"></div>

                    <div class="absolute inset-0 flex flex-col p-6 text-white">
                        <h1 class="text-3xl font-reaktifSemibold">01</h1>
                        <h1 class="text-3xl font-reaktifSemibold">Vuelos</h1>
                    </div>
                </div>

                <div class="service-hotel relative w-[280px] h-[280px] rounded-2xl overflow-hidden bg-[#000000]/60">
                    <Image
                            class="w-full h-full object-top object-cover"
                            src={Service_Hotel_Img}
                            alt="service_hotel_img"
                            loading="lazy"
                            decoding="async"
                    />

                    <div class="absolute inset-0 bg-black bg-opacity-50"></div>

                    <div class="absolute inset-0 flex flex-col p-6 text-white">
                        <h1 class="text-3xl font-reaktifSemibold">02</h1>
                        <h1 class="text-3xl font-reaktifSemibold">Hoteles</h1>
                    </div>
                </div>

                <div class="service-car-rental relative w-[240px] h-[240px] rounded-2xl overflow-hidden bg-[#000000]/60">
                    <Image
                            class = { 'w-full h-full object-cover' }
                            src = { Service_Car_Rental_Img }
                            alt = { 'service_car_rental_img' }
                            loading = { 'lazy' }
                            decoding = { 'async' }
                    />

                    <div class="absolute inset-0 bg-black bg-opacity-50"></div>

                    <div class="absolute inset-0 flex flex-col p-6 text-white">
                        <h1 class="text-3xl font-reaktifSemibold">03</h1>
                        <h1 class="text-3xl font-reaktifSemibold">Autos</h1>
                    </div>
                </div>
            </div>
        </div>

        <div class="w-full flex justify-end">
            <div class="navigation-buttons pr-20 font-reaktifNews relative flex items-center justify-between max-w-[900px] w-full">
                <div class="count-text">
                    <span class="text-4xl text-[#333333]" >02</span>
                    <span class="text-2xl text-[#78858F]" >/06</span>
                </div>

                <div class="buttons flex items-center gap-4">
                    <Button appName="btn-prev" className = { "rounded-full bg-[#F2F2F2] w-[50px] h-[50px] justify-items-center" } >
                        <ChevronLeft color="#344054" />
                    </Button>
                    <Button appName="btn-next" className = { "rounded-full bg-[#F2F2F2] w-[50px] h-[50px] justify-items-center" } >
                        <ChevronRight color="#344054" />
                    </Button>
                </div>
            </div>
        </div>
    </div>
</div>